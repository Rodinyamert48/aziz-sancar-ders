---
import { discoveries, repairSteps, type Base } from '../data/site'

const label: Record<Base, string> = {
  ok: 'sağlam',
  hurt: 'hasarlı',
  cut: 'kesim noktası',
  gap: 'boşluk',
  fresh: 'yeni',
  none: '',
}
---

<section id="kesifleri" class="night">
  <div class="wrap inner">
    <p class="eyebrow" data-reveal>Bölüm II</p>
    <h2 class="section-title" data-reveal style="--delay: 0.08s">Üç keşif, tek soru: hücre DNA'sını nasıl korur?</h2>

    <div class="cards">
      {
        discoveries.map((d, i) => (
          <article class="card" data-reveal style={`--delay:${i * 0.1}s`}>
            <p class:list={['meta', { gold: d.highlight }]}>
              {d.no} · {d.era}
            </p>
            <h3>{d.title}</h3>
            <p class="text">{d.text}</p>
          </article>
        ))
      }
    </div>

    <div class="how-head" data-reveal>
      <h3>Eksizyon onarımı, dört adımda</h3>
      <p>Kitaptaki hatalı satırı makasla kesip yerine doğrusunu yazmak gibi.</p>
    </div>

    <ol class="steps">
      {
        repairSteps.map((s, k) => (
          <li class="step" data-reveal style={`--delay:${k * 0.12}s`}>
            <div class="dna" role="img" aria-label={`${s.title} adımı: DNA şeridinin şematik çizimi`}>
              <div class="row lifted">
                {s.lifted.map((b, i) => (
                  <span class={`b ${b}`} style={`--i:${i}`} title={label[b] || undefined} />
                ))}
              </div>
              <div class="row">
                {s.top.map((b, i) => (
                  <span class={`b ${b}`} style={`--i:${i}`} />
                ))}
              </div>
              <div class="row">
                {s.top.map((_, i) => (
                  <span class="b base" style={`--i:${i}`} />
                ))}
              </div>
            </div>
            <p class="no">{s.no}</p>
            <h4>{s.title}</h4>
            <p class="text">{s.text}</p>
          </li>
        ))
      }
    </ol>

    <ul class="legend" aria-label="Renklerin anlamı" data-reveal>
      <li><span class="b ok"></span>Sağlam baz</li>
      <li><span class="b hurt"></span>UV hasarı</li>
      <li><span class="b cut"></span>Kesim noktası</li>
      <li><span class="b fresh"></span>Yeni yazılan baz</li>
    </ul>
  </div>
</section>

<style>
  .night {
    background: var(--night);
    color: var(--paper);
  }
  .inner {
    padding-block: clamp(80px, 11vw, 104px);
  }
  .eyebrow {
    margin-bottom: 16px;
    color: var(--gold-light);
  }
  .section-title {
    max-width: 820px;
  }
  .cards {
    margin-top: 64px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 1px;
    background: var(--night-rule);
    border: 1px solid var(--night-rule);
  }
  .card {
    background: var(--night);
    padding: 36px 32px;
    transition: background 0.3s;
  }
  .card:hover {
    background: #24211c;
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--night-muted);
  }
  .meta.gold {
    color: var(--gold-light);
  }
  .card h3 {
    margin-top: 20px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 32px;
    line-height: 1.1;
  }
  .text {
    margin-top: 14px;
    color: var(--night-text);
    font-size: 17px;
  }

  .how-head {
    margin-top: 96px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
  }
  .how-head h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(28px, 3vw, 36px);
    line-height: 1.1;
  }
  .how-head p {
    max-width: 420px;
    color: var(--night-muted);
    font-size: 16px;
  }
  .steps {
    margin-top: 40px;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
    gap: 24px;
  }
  .step {
    border-top: 1px solid #5a554c;
    padding-top: 24px;
  }
  .dna {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-block: 20px;
  }
  .row {
    display: flex;
    gap: 4px;
    min-height: 18px;
  }
  .row.lifted {
    min-height: 22px;
    transform: translateY(-4px);
  }
  .b {
    flex: 0 0 auto;
    width: 14px;
    height: 18px;
    border-radius: 3px;
  }
  .ok {
    background: var(--gold-light);
  }
  .hurt {
    background: var(--damage-light);
  }
  .cut {
    background: var(--gold-light);
    box-shadow:
      0 0 0 2px var(--night),
      0 0 0 3px var(--paper);
  }
  .gap {
    border: 1px dashed #8a8274;
  }
  .fresh {
    background: var(--helix-light);
  }
  .none {
    visibility: hidden;
  }
  .base {
    background: #5a554c;
  }
  .no {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--gold-light);
  }
  h4 {
    margin-top: 8px;
    font-size: 20px;
    font-weight: 600;
  }
  .step .text {
    margin-top: 8px;
    font-size: 16px;
  }

  /* bazlar adım göründüğünde sırayla yerine oturur */
  .js .step .b {
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 0.4s ease,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--delay, 0s) + 0.3s + var(--i) * 0.04s);
  }
  .js .step.is-visible .b {
    opacity: 1;
    transform: none;
  }
  .js .step.is-visible .none {
    opacity: 0;
  }

  .legend {
    margin-top: 48px;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    font-size: 14px;
    color: var(--night-muted);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  @media (prefers-reduced-motion: reduce) {
    .js .step .b {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
