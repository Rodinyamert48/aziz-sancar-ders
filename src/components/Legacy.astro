---
import { legacy, site, sources } from '../data/site'
---

<section id="mirasi" class="legacy">
  <div class="wrap inner">
    <p class="eyebrow" data-reveal>Bölüm IV</p>
    <h2 class="section-title" data-reveal style="--delay: 0.08s">Laboratuvardan hayata, Chapel Hill'den Anıtkabir'e</h2>
    <div class="items">
      {
        legacy.map((item, i) => (
          <div data-reveal style={`--delay:${i * 0.08}s`}>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        ))
      }
    </div>
    <blockquote data-reveal>
      <p>
        Mütevazı bir aileden, küçük bir ilçeden gelen bir çocuğun azim, merak ve iyi öğretmenlerle dünyanın en büyük bilim
        ödülüne ulaşabileceğinin kanıtı.
      </p>
    </blockquote>
  </div>
</section>

<footer class="wrap footer">
  <div>
    <p class="name">Aziz Sancar</p>
    <p>{site.course} · {site.presenter}</p>
  </div>
  <ul class="sources" aria-label="Kaynaklar">
    {
      sources.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer">
            {s.label}
          </a>
        </li>
      ))
    }
  </ul>
</footer>

<style>
  .legacy {
    background: var(--paper-2);
    border-top: 1px solid var(--rule);
  }
  .inner {
    padding-block: clamp(88px, 12vw, 112px);
  }
  .eyebrow {
    margin-bottom: 16px;
  }
  .section-title {
    max-width: 820px;
  }
  .items {
    margin-top: 64px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 48px 40px;
  }
  h3 {
    font-size: 20px;
    font-weight: 600;
  }
  .items p {
    margin-top: 10px;
    color: var(--ink-2);
    font-size: 17px;
  }
  blockquote {
    margin-top: clamp(64px, 9vw, 96px);
    padding-top: 48px;
    border-top: 1px solid var(--ink);
  }
  blockquote p {
    max-width: 940px;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(26px, 3.2vw, 40px);
    line-height: 1.3;
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 32px;
    padding-block: 56px 64px;
    font-size: 15px;
    color: var(--ink-2);
  }
  .name {
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--ink);
  }
  .footer p + p {
    margin-top: 6px;
  }
  .sources {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    padding: 0;
    list-style: none;
  }
  .sources a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .sources a:hover {
    color: var(--gold);
  }
</style>
